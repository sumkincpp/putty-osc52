+/*
+ * OSC 52 limits: 100 KiB of decoded text, which is 136536 characters
+ * of Base64, plus room for the selection parameter.
+ */
+#define OSC52_MAX_DECODED 102400
+#define OSC52_MAX_B64 (((OSC52_MAX_DECODED + 2) / 3) * 4)
+#define OSC52_MAX_RAW (OSC52_MAX_B64 + 64)
+
+/*
+ * Append a byte to the current OSC string. OSC 52 payloads go in a
+ * separate growable buffer, and only if the feature is enabled.
+ */
+static void osc_append(Terminal *term, unsigned char c)
+{
+    if (term->osc_type == OSCLIKE_OSC && term->esc_args[0] == 52 &&
+        term->osc52_write) {
+        if (!term->osc52_buf)
+            term->osc52_buf = strbuf_new();
+        if (term->osc52_buf->len < OSC52_MAX_RAW)
+            put_byte(term->osc52_buf, c);
+        else
+            term->osc52_overflow = true;
+    } else if (term->osc_strlen < OSC_STR_MAX) {
+        term->osc_string[term->osc_strlen++] = (char)c;
+    }
+}
+
+#define OSC52_PREVIEW_CHARS 120
+
+/*
+ * Describe an OSC 52 request for the confirmation prompt: size, line
+ * count, and the start of the text with control and bidi characters
+ * defanged so the preview cannot disguise itself. data is valid UTF-8.
+ */
+static char *osc52_prompt(ptrlen data)
+{
+    size_t lines = 1;
+    for (size_t i = 0; i < data.len; i++)
+        if (((const char *)data.ptr)[i] == '\n')
+            lines++;
+
+    strbuf *pv = strbuf_new();
+    BinarySource src[1];
+    BinarySource_BARE_INIT_PL(src, data);
+    size_t shown = 0;
+    bool truncated = false;
+    while (get_avail(src)) {
+        DecodeUTF8Failure err;
+        unsigned cp = decode_utf8(src, &err);
+        if (shown >= OSC52_PREVIEW_CHARS) {
+            truncated = true;
+            break;
+        }
+        if (cp == '\n' || cp == '\r' || cp == '\t')
+            cp = ' ';
+        else if (cp < 0x20 || (cp >= 0x7f && cp < 0xa0) ||
+                 (cp >= 0x200b && cp <= 0x200f) ||
+                 (cp >= 0x202a && cp <= 0x202e) ||
+                 (cp >= 0x2066 && cp <= 0x2069) || cp == 0xfeff)
+            cp = '.';
+        put_utf8_char(pv, cp);
+        shown++;
+    }
+
+    char *msg = dupprintf(
+        "The remote system wants to replace your clipboard.\n\n"
+        "Size: %"SIZEu" bytes, %"SIZEu" line%s\n\n"
+        "Starts with:\n%s%s\n\nAllow this?",
+        data.len, lines, lines == 1 ? "" : "s",
+        pv->s, truncated ? "..." : "");
+    strbuf_free(pv);
+    return msg;
+}
+
+/*
+ * OSC 52 ; selection ; data. Write-only: queries ("?") are ignored
+ * without a reply, and anything malformed is silently dropped.
+ */
+static void do_osc52(Terminal *term)
+{
+    if (term->osc52_write == OSC52_DENY || !term->osc52_buf ||
+        term->osc52_overflow ||
+        (term->osc52_write == OSC52_ASK && term->osc52_denied))
+        return;
+
+    ptrlen all = ptrlen_from_strbuf(term->osc52_buf);
+    const char *semi = memchr(all.ptr, ';', all.len);
+    if (!semi)
+        return;                        /* no selection/payload split */
+
+    /* Selection parameter must be letters/digits; its value is ignored */
+    for (const char *p = all.ptr; p < semi; p++)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9')))
+            return;
+
+    ptrlen b64 = make_ptrlen(semi + 1, all.len - (semi + 1 - (const char *)all.ptr));
+    if (b64.len == 0 || b64.len > OSC52_MAX_B64)
+        return;
+    if (b64.len == 1 && *(const char *)b64.ptr == '?')
+        return;                        /* clipboard read: never answered */
+    if (b64.len % 4 != 0 || !base64_valid(b64))
+        return;
+
+    strbuf *dec = base64_decode_sb(b64);
+    if (dec->len > OSC52_MAX_DECODED || dec->len == 0) {
+        strbuf_free(dec);
+        return;
+    }
+
+    /* Worst case: every byte is a newline expanded to sel_nl_sz */
+    size_t maxlen = dec->len * (sel_nl_sz > 1 ? sel_nl_sz : 1) + 1;
+    wchar_t *text = snewn(maxlen, wchar_t);
+    size_t n = 0;
+    bool ok = true;
+    BinarySource src[1];
+    BinarySource_BARE_INIT_PL(src, ptrlen_from_strbuf(dec));
+    while (get_avail(src)) {
+        DecodeUTF8Failure err;
+        wchar_t wc[2];
+        size_t nw = decode_utf8_to_wchar(src, wc, &err);
+        if (err != DUTF8_SUCCESS || wc[0] == 0) {
+            ok = false;                /* invalid UTF-8 or embedded NUL */
+            break;
+        }
+        if (nw == 1 && wc[0] == '\n') {
+            if (n > 0 && text[n-1] == '\r')
+                n--;                   /* CRLF -> one newline */
+            for (size_t i = 0; i < sel_nl_sz; i++)
+                text[n++] = sel_nl[i];
+        } else {
+            for (size_t i = 0; i < nw; i++)
+                text[n++] = wc[i];
+        }
+    }
+    char *prompt = NULL;
+    if (ok && n > 0 && term->osc52_write == OSC52_ASK)
+        prompt = osc52_prompt(ptrlen_from_strbuf(dec));
+    strbuf_free(dec);
+
+    if (ok && n > 0) {
+        bool allow = true;
+        if (prompt) {
+            allow = win_confirm_clip_write(term->win, prompt);
+            if (!allow)
+                term->osc52_denied = true;   /* don't let the host nag */
+        }
+        if (allow) {
+            int *attrs = snewn(n, int);
+            truecolour *tcs = snewn(n, truecolour);
+            for (size_t i = 0; i < n; i++) {
+                attrs[i] = 0;
+                tcs[i] = term->basic_erase_char.truecolour;
+            }
+            win_clip_write(term->win, OSC52_CLIPBOARD, text, attrs, tcs, n,
+                           false);
+            sfree(attrs);
+            sfree(tcs);
+        }
+    }
+    sfree(prompt);
+    sfree(text);
+}
