+static bool wintw_confirm_clip_write(TermWin *tw, const char *msg)
+{
+    WinGuiSeat *wgs = container_of(tw, WinGuiSeat, termwin);
+    wchar_t *wmsg = dup_mb_to_wc(CP_UTF8, msg);
+    char *title = dupprintf("%s clipboard request", appname);
+    wchar_t *wtitle = dup_mb_to_wc(CP_UTF8, title);
+    show_mouseptr(wgs, true);
+    int r = MessageBoxW(wgs->term_hwnd, wmsg, wtitle,
+                        MB_YESNO | MB_ICONWARNING | MB_DEFBUTTON2);
+    sfree(wmsg);
+    sfree(wtitle);
+    sfree(title);
+    return r == IDYES;
+}
