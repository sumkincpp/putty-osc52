+    for (size_t i = 0; i < lenof(sels); i++) {
+        reset(mk);
+        osc52_send(mk, sels[i], "aGVsbG8=", i % 2 ? "\033\\" : "\007");
+        IEQUAL(mk->nclip, 1);
+        IEQUAL(mk->clip_id, OSC52_CLIPBOARD);
+        SEQUAL(mk->clip->s, "hello");
+        /* Terminal state is back to normal afterwards */
+        term_datapl(mk->term, PTRLEN_LITERAL("x"));
+        IEQUAL(get_termchar(mk->term, 0, 0).chr, CSET_ASCII | 'x');
+    }
+
+    /* C1 ST as UTF-8 */
