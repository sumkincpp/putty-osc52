+    osc52_send(mk, "c;", "aGVsbG8=", "\xC2\x9C");
+    SEQUAL(mk->clip->s, "hello");
+
+    /* Unicode: "h\xC3\xA9llo \xE2\x82\xAC \xF0\x9F\x98\x80" */
+    reset(mk);
+    osc52_send(mk, "c;", "aMOpbGxvIOKCrCDwn5iA", "\007");
+    IEQUAL(mk->nclip, 1);
+    SEQUAL(mk->clip->s, "h\xC3\xA9llo \xE2\x82\xAC \xF0\x9F\x98\x80");
+
+    /* Read queries are ignored, with no reply (no ldisc to reply to
+     * either, so check nothing is written and the terminal survives) */
+    reset(mk);
+    osc52_send(mk, "c;", "?", "\007");
+    osc52_send(mk, ";", "?", "\033\\");
+    IEQUAL(mk->nclip, 0);
+
+    /* Malformed sequences */
+    static const char *const bad_b64[] = {
+        "aGVsbG8", "aGVs bG8=", "a*Vs", "=aGVsbG8", "aGVsbG8==", "====",
+        "aGVsbG8=aGVsbG8=", "", "!" };
+    for (size_t i = 0; i < lenof(bad_b64); i++) {
+        reset(mk);
+        osc52_send(mk, "c;", bad_b64[i], "\007");
+        IEQUAL(mk->nclip, 0);
+    }
+    reset(mk);
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;aGVsbG8=\007")); /* no sel */
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52\007"));
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;\007"));
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c\007"));
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c;\007"));
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c d;aGVsbG8=\007"));
+    IEQUAL(mk->nclip, 0);
+
+    /* Aborted by newline: no write, and the newline is processed */
+    reset(mk);
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c;aGVsbG8=\r\n"));
+    IEQUAL(mk->nclip, 0);
+    IEQUAL(mk->term->curs.y, 1);
+
+    /* Invalid UTF-8 and embedded NUL: rejected whole (/w== is 0xFF, 4oI= is
+     * a truncated E2 82, AGE= is NUL 'a') */
+    static const char *const bad_utf8[] = { "/w==", "4oI=", "AGE=", "gA==" };
+    for (size_t i = 0; i < lenof(bad_utf8); i++) {
+        reset(mk);
+        osc52_send(mk, "c;", bad_utf8[i], "\007");
+        IEQUAL(mk->nclip, 0);
+    }
+
+    /* Size limits: exactly 100 KiB is accepted, one more byte is not,
+     * and a payload far larger than that is discarded safely */
+    for (int pass = 0; pass < 3; pass++) {
+        size_t n = pass == 0 ? 102400 : pass == 1 ? 102401 : 1000000;
+        strbuf *raw = strbuf_new();
+        for (size_t i = 0; i < n; i++)
+            put_byte(raw, 'a' + i % 26);
+        strbuf *b64 = base64_encode_sb(ptrlen_from_strbuf(raw), 0);
+        reset(mk);
+        osc52_send(mk, "c;", b64->s, "\007");
+        IEQUAL(mk->nclip, pass == 0 ? 1 : 0);
+        if (pass == 0) {
+            IEQUAL(mk->clip->len, 102400);
+            IEQUAL(memcmp(mk->clip->s, raw->s, 102400), 0);
+        }
+        term_datapl(mk->term, PTRLEN_LITERAL("x"));
+        IEQUAL(get_termchar(mk->term, 0, 0).chr, CSET_ASCII | 'x');
+        strbuf_free(raw);
+        strbuf_free(b64);
+    }
+
+    /* Newlines are converted to the platform selection newline */
+    reset(mk);
+    osc52_send(mk, "c;", "YQpiDQpj", "\007");   /* a\nb\r\nc */
+    IEQUAL(mk->nclip, 1);
+    SEQUAL(mk->clip->s, SEL_NL_TEST_STR("a", "b", "c"));
+
+    /* Other OSC sequences are unaffected */
+    reset(mk);
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]2;title\007"));
+    term_update(mk->term);
+    SEQUAL(mk->title->s, "title");
+
+    /* Disabling again turns writes off */
+    osc52_set(mk, OSC52_DENY);
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nclip, 0);
+}
+
+static bool has_str(const char *hay, const char *needle)
+{
+    return strstr(hay, needle) != NULL;
+}
+
+static void test_osc52_ask(Mock *mk)
+{
+    mk->ucsdata->line_codepage = CP_UTF8;
+
+    /* Ask + allow: prompted once, then written */
+    osc52_set(mk, OSC52_ASK);
+    mk->confirm_answer = true;
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");          /* hello */
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(mk->nclip, 1);
+    SEQUAL(mk->clip->s, "hello");
+    IEQUAL(has_str(mk->confirm_msg->s, "5 bytes, 1 line"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "hello"), true);
+
+    /* Allowed requests keep prompting each time */
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 2);
+    IEQUAL(mk->nclip, 2);
+
+    /* Ask + deny: nothing written, and further requests are not
+     * prompted for until reconfiguration */
+    osc52_set(mk, OSC52_ASK);
+    mk->confirm_answer = false;
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(mk->nclip, 0);
+    mk->confirm_answer = true;
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(mk->nclip, 0);
+    osc52_set(mk, OSC52_ASK);                         /* resets the denial */
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 2);
+    IEQUAL(mk->nclip, 1);
+
+    /* Invalid or empty requests never reach the prompt */
+    reset(mk);
+    osc52_send(mk, "c;", "?", "\007");
+    osc52_send(mk, "c;", "/w==", "\007");
+    osc52_send(mk, "c;", "aGVsbG8", "\007");
+    IEQUAL(mk->nconfirm, 0);
+    IEQUAL(mk->nclip, 0);
+
+    /* Preview: line count, newlines flattened, controls and bidi
+     * overrides defanged ("a\nb\x01\xE2\x80\xAEz\nc" ) */
+    reset(mk);
+    osc52_send(mk, "c;", "YQpiAeKArnoKYw==", "\007");
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(has_str(mk->confirm_msg->s, "3 lines"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "a b..z c"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "\xE2\x80\xAE"), false);
+    IEQUAL(has_str(mk->confirm_msg->s, "\x01"), false);
+
+    /* Long text: preview truncated, full text still written */
+    {
+        strbuf *raw = strbuf_new();
+        for (size_t i = 0; i < 1000; i++)
+            put_byte(raw, 'a' + i % 26);
+        strbuf *b64 = base64_encode_sb(ptrlen_from_strbuf(raw), 0);
+        reset(mk);
+        osc52_send(mk, "c;", b64->s, "\007");
+        IEQUAL(mk->nconfirm, 1);
+        IEQUAL(mk->nclip, 1);
+        IEQUAL(mk->clip->len, 1000);
+        IEQUAL(has_str(mk->confirm_msg->s, "1000 bytes"), true);
+        IEQUAL(has_str(mk->confirm_msg->s, "..."), true);
+        IEQUAL(strlen(mk->confirm_msg->s) < 400, true);
+        strbuf_free(raw);
+        strbuf_free(b64);
+    }
+
+    /* Allow never prompts */
+    osc52_set(mk, OSC52_ALLOW);
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 0);
+    IEQUAL(mk->nclip, 1);
+
+    osc52_set(mk, OSC52_DENY);
+}
