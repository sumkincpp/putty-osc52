+#define OSC52_PREVIEW_CHARS 120
+
+/*
+ * Describe an OSC 52 request for the confirmation prompt: size, line
+ * count, and the start of the text with control and bidi characters
+ * defanged so the preview cannot disguise itself. data is valid UTF-8.
+ */
+static char *osc52_prompt(ptrlen data)
+{
+    const char *text = data.ptr;
+    size_t lines = 1;                  /* one more than the number of newlines */
+    for (size_t i = 0; i < data.len; i++)
+        if (text[i] == '\n')
+            lines++;
+
+    strbuf *pv = strbuf_new();
+    BinarySource src[1];
+    BinarySource_BARE_INIT_PL(src, data);
+    size_t shown = 0;
+    bool truncated = false;
+    while (get_avail(src)) {
+        DecodeUTF8Failure err;
+        unsigned cp = decode_utf8(src, &err);
+        if (shown >= OSC52_PREVIEW_CHARS) {
+            truncated = true;
+            break;
+        }
+        /* Line breaks and tabs become spaces, so the preview is one line */
+        if (cp == '\n' || cp == '\r' || cp == '\t')
+            cp = ' ';
+        /* Other control characters, and characters that invisibly change
+         * how text is drawn, are shown as '.' so they can't disguise it */
+        else if (cp < 0x20 || (cp >= 0x7f && cp < 0xa0) ||   /* C0, DEL, C1 */
+                 (cp >= 0x200b && cp <= 0x200f) ||   /* zero-width, LRM, RLM */
+                 (cp >= 0x202a && cp <= 0x202e) ||   /* embeddings, overrides */
+                 (cp >= 0x2066 && cp <= 0x2069) ||   /* isolates */
+                 cp == 0xfeff)                       /* zero-width no-break space */
+            cp = '.';
+        put_utf8_char(pv, cp);
+        shown++;
+    }
+
+    char *msg = dupprintf(
+        "The remote system wants to replace your clipboard.\n\n"
+        "Size: %"SIZEu" bytes, %"SIZEu" line%s\n\n"
+        "Starts with:\n%s%s\n\nAllow this?",
+        data.len, lines, lines == 1 ? "" : "s",
+        pv->s, truncated ? "..." : "");
+    strbuf_free(pv);
+    return msg;
+}
+
+/*
+ * Add OSC 52 text to buf: UTF-8 decoded to wchar_t, with newlines changed
+ * to the selection newline and with plain attributes, as clipme does for
+ * text that has no formatting. False if it is not valid UTF-8 or has a NUL.
+ */
+static bool osc52_text(Terminal *term, ptrlen utf8, clip_workbuf *buf)
+{
+    truecolour tc = term->basic_erase_char.truecolour;
+    BinarySource src[1];
+    BinarySource_BARE_INIT_PL(src, utf8);
+
+    while (get_avail(src)) {
+        DecodeUTF8Failure err;
+        wchar_t wc[2];
+        size_t nw = decode_utf8_to_wchar(src, wc, &err);
+        if (err != DUTF8_SUCCESS || wc[0] == 0)
+            return false;
+        if (wc[0] == '\r' && get_avail(src) &&
+            *(const char *)get_ptr(src) == '\n')
+            continue;                  /* CRLF -> one newline */
+        if (nw == 1 && wc[0] == '\n') {
+            for (size_t i = 0; i < sel_nl_sz; i++)
+                clip_addchar(buf, sel_nl[i], 0, tc);
+        } else {
+            for (size_t i = 0; i < nw; i++)
+                clip_addchar(buf, wc[i], 0, tc);
+        }
+    }
+    return true;
+}
+
+/*
+ * The decoded text of the OSC 52 request in term->osc52_buf, or NULL if
+ * the request is not allowed or not valid. Queries ("?") are ignored
+ * without a reply, and anything malformed is silently dropped.
+ */
+static strbuf *osc52_decode(Terminal *term)
+{
+    if (term->osc52_write == OSC52_DENY || !term->osc52_buf ||
+        term->osc52_overflow ||
+        (term->osc52_write == OSC52_ASK && term->osc52_denied))
+        return NULL;
+
+    ptrlen all = ptrlen_from_strbuf(term->osc52_buf);
+    const char *semi = memchr(all.ptr, ';', all.len);
+    if (!semi)
+        return NULL;                   /* no selection/payload split */
+
+    ptrlen sel = make_ptrlen_startend(all.ptr, semi);
+    ptrlen b64 = make_ptrlen_startend(semi + 1, ptrlen_end(all));
+
+    /* Selection parameter must be letters/digits; its value is ignored */
+    if (!ptrlen_contains_only(sel, "abcdefghijklmnopqrstuvwxyz0123456789"))
+        return NULL;
+    if (b64.len == 0 || b64.len > OSC52_MAX_B64(term->osc52_max))
+        return NULL;
+    if (ptrlen_eq_string(b64, "?"))
+        return NULL;                   /* clipboard read: never answered */
+    if (b64.len % 4 != 0 || !base64_valid(b64))
+        return NULL;
+
+    strbuf *dec = base64_decode_sb(b64);
+    if (dec->len == 0 || dec->len > term->osc52_max) {
+        strbuf_free(dec);
+        return NULL;
+    }
+    return dec;
+}
+
+/*
+ * OSC 52 ; selection ; data. Write-only: puts the text on the clipboard,
+ * after asking the user first if the setting says so.
+ */
+static void do_osc52(Terminal *term)
+{
+    strbuf *dec = osc52_decode(term);
+    if (!dec)
+        return;
+
+    /*
+     * Unlike clipme's, this buffer starts empty (all zero) and gets its
+     * space on the first clip_addchar.
+     */
+    clip_workbuf buf;
+    memset(&buf, 0, sizeof(buf));
+    char *prompt = NULL;
+
+    if (osc52_text(term, ptrlen_from_strbuf(dec), &buf)) {
+        if (term->osc52_write == OSC52_ASK)
+            prompt = osc52_prompt(ptrlen_from_strbuf(dec));
+
+        if (prompt && !win_confirm_clip_write(term->win, prompt)) {
+            term->osc52_denied = true; /* don't let the host nag */
+        } else {
+#if SELECTION_NUL_TERMINATED
+            clip_addchar(&buf, 0, 0, term->basic_erase_char.truecolour);
+#endif
+            win_clip_write(term->win, OSC52_CLIPBOARD, buf.textbuf,
+                           buf.attrbuf, buf.tcbuf, buf.bufpos, false);
+        }
+    }
+
+    strbuf_free(dec);
+    sfree(prompt);
+    sfree(buf.textbuf);
+    sfree(buf.attrbuf);
+    sfree(buf.tcbuf);
+}
