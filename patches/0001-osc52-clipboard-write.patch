+/*
+ * OSC 52 size limit (term->osc52_max, 100 KiB of decoded text by default).
+ * That many bytes are 136536 characters of Base64; the raw string also
+ * has room for the selection parameter.
+ */
+#define OSC52_MAX_B64(n) ((((n) + 2) / 3) * 4)
+#define OSC52_MAX_RAW(n) (OSC52_MAX_B64(n) + 64)
+
+/*
+ * OSC 52 payloads are too long for osc_string, so they go in their own
+ * growable buffer, if the feature is enabled. Returns true if the byte
+ * was taken.
+ */
+static bool osc52_append(Terminal *term, unsigned char c)
+{
+    if (term->osc_type != OSCLIKE_OSC || term->esc_args[0] != 52 ||
+        term->osc52_write == OSC52_DENY)
+        return false;
+    if (!term->osc52_buf)
+        term->osc52_buf = strbuf_new();
+    if (term->osc52_buf->len < OSC52_MAX_RAW(term->osc52_max))
+        put_byte(term->osc52_buf, c);
+    else
+        term->osc52_overflow = true;
+    return true;
+}
