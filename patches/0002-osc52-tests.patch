+static void mock_clip_write(
+    TermWin *win, int clipboard, wchar_t *text, int *attrs,
+    truecolour *colours, int len, bool deselect)
+{
+    Mock *mk = container_of(win, Mock, tw);
+    mk->nclip++;
+    mk->clip_id = clipboard;
+    strbuf_clear(mk->clip);
+    mk->clip_nul = len > 0 && text[len-1] == 0;
+    if (mk->clip_nul)
+        len--;
+    for (int i = 0; i < len; i++) {
+        unsigned wc = text[i];
+        if (sizeof(wchar_t) == 2 && wc >= 0xD800 && wc < 0xDC00 &&
+            i+1 < len) {
+            wc = 0x10000 + ((wc & 0x3FF) << 10) + (text[++i] & 0x3FF);
+        }
+        put_utf8_char(mk->clip, wc);
+    }
+}
+
+static bool mock_confirm_clip_write(TermWin *win, const char *msg)
+{
+    Mock *mk = container_of(win, Mock, tw);
+    mk->nconfirm++;
+    strbuf_clear(mk->confirm_msg);
+    put_dataz(mk->confirm_msg, msg);
+    return mk->confirm_answer;
+}
