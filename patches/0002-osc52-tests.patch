+static void osc52_set(Mock *mk, int mode)
+{
+    conf_set_int(mk->conf, CONF_osc52_write, mode);
+    term_reconfig(mk->term, mk->conf);
+}
+
+static void osc52_send(Mock *mk, const char *prefix, const char *b64,
+                       const char *term_str)
+{
+    char *s = dupcat("\033]52;", prefix, b64, term_str);
+    term_data(mk->term, s, strlen(s));
+    sfree(s);
+}
+
+/* Send n bytes of text as one OSC 52 request; true if it was written intact */
+static bool osc52_send_size(Mock *mk, size_t n)
+{
+    strbuf *raw = strbuf_new();
+    for (size_t i = 0; i < n; i++)
+        put_byte(raw, 'a' + i % 26);
+    strbuf *b64 = base64_encode_sb(ptrlen_from_strbuf(raw), 0);
+    reset(mk);
+    osc52_send(mk, "c;", b64->s, "\007");
+    bool intact = mk->nclip == 1 && mk->clip->len == n &&
+        memcmp(mk->clip->s, raw->s, n) == 0;
+    strbuf_free(raw);
+    strbuf_free(b64);
+    return intact;
+}
+
+static void test_osc52(Mock *mk)
+{
+    mk->ucsdata->line_codepage = CP_UTF8;
+
+    /* Disabled by default */
+    IEQUAL(conf_get_int(mk->conf, CONF_osc52_write), OSC52_DENY);
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nclip, 0);
+
+    osc52_set(mk, OSC52_ALLOW);
+
+    /* BEL and ST terminators, and the assorted selection parameters */
+    static const char *const sels[] = {
+        "c;",                          /* the clipboard */
+        "p;",                          /* the primary selection */
+        "s;",                          /* the "select" target */
+        "cp;",                         /* clipboard and primary together */
+        ";",                           /* empty: the default target */
+        "0;",                          /* cut buffer 0 */
+        "pc;",                         /* same pair, other order */
+        "c;",                          /* clipboard again, other terminator */
+    };
+    for (size_t i = 0; i < lenof(sels); i++) {
+        reset(mk);
+        osc52_send(mk, sels[i], "aGVsbG8=", i % 2 ? "\033\\" : "\007");
+        IEQUAL(mk->nclip, 1);
+        IEQUAL(mk->clip_id, OSC52_CLIPBOARD);
+        /* Where the platform wants clipboard text NUL-terminated, we send
+         * the NUL, as copying the selection does */
+        IEQUAL(mk->clip_nul, SELECTION_NUL_TERMINATED);
+        SEQUAL(mk->clip->s, "hello");
+        /* Terminal state is back to normal afterwards */
+        term_datapl(mk->term, PTRLEN_LITERAL("x"));
+        IEQUAL(get_termchar(mk->term, 0, 0).chr, CSET_ASCII | 'x');
+    }
+
+    /* End with C1 ST (U+009C, the string terminator). In UTF-8 mode it
+     * arrives as the two bytes C2 9C: the terminal sees C2, waits for the
+     * next byte, and if that is 9C the string is ended; any other byte
+     * would make C2 part of the string instead */
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\xC2\x9C");
+    SEQUAL(mk->clip->s, "hello");
+
+    /* Non-ASCII text must survive UTF-8 -> wchar_t -> UTF-8, one character
+     * of each UTF-8 length: e-acute (2 bytes), euro sign (3 bytes) and an
+     * emoji (4 bytes, which is a surrogate pair where wchar_t is 16 bits).
+     * The Base64 below is the UTF-8 text "h<e-acute>llo <euro> <emoji>" */
+    reset(mk);
+    osc52_send(mk, "c;", "aMOpbGxvIOKCrCDwn5iA", "\007");
+    IEQUAL(mk->nclip, 1);
+    SEQUAL(mk->clip->s, "h\xC3\xA9llo \xE2\x82\xAC \xF0\x9F\x98\x80");
+
+    /* Read queries ("?" instead of data) are ignored: nothing is written
+     * and no reply is sent. The mock has no line discipline, so the reply
+     * itself can't be checked, only the write and the terminal state */
+    reset(mk);
+    osc52_send(mk, "c;", "?", "\007");
+    osc52_send(mk, ";", "?", "\033\\");
+    IEQUAL(mk->nclip, 0);
+    /* The terminal is back to normal afterwards */
+    term_datapl(mk->term, PTRLEN_LITERAL("x"));
+    IEQUAL(get_termchar(mk->term, 0, 0).chr, CSET_ASCII | 'x');
+
+    /* Malformed Base64 must not change the clipboard */
+    static const char *const bad_b64[] = {
+        "aGVsbG8", "aGVs bG8=", "a*Vs", "=aGVsbG8", "aGVsbG8==", "====",
+        "aGVsbG8=aGVsbG8=", "", "!" };
+    for (size_t i = 0; i < lenof(bad_b64); i++) {
+        reset(mk);
+        osc52_send(mk, "c;", bad_b64[i], "\007");
+        IEQUAL(mk->nclip, 0);
+    }
+    /* A wrong layout (not 52;<selection>;<data>) must not change the
+     * clipboard: missing or invalid selection, missing or empty data */
+    reset(mk);
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;aGVsbG8=\007"));  /* no selection */
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52\007"));           /* nothing after 52 */
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;\007"));          /* no selection, no data */
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c\007"));         /* no second ';' */
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c;\007"));        /* empty data */
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c d;aGVsbG8=\007")); /* space in selection */
+    IEQUAL(mk->nclip, 0);
+
+    /* No terminator: the newline aborts the OSC string, so nothing is
+     * written, and the newline is then handled as ordinary input */
+    reset(mk);
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]52;c;aGVsbG8=\r\n"));
+    IEQUAL(mk->nclip, 0);              /* the request was dropped */
+    IEQUAL(mk->term->curs.y, 1);       /* the newline moved the cursor down */
+
+    /* Bad UTF-8 or NUL (valid Base64, bad bytes) must not change the
+     * clipboard; caught by decode_utf8_to_wchar and do_osc52 */
+    static const char *const bad_utf8[] = {
+        "/w==",                        /* FF: never valid in UTF-8 */
+        "4oI=",                        /* E2 82: a 3-byte character cut short */
+        "AGE=",                        /* 00 61: NUL, then 'a' */
+        "gA==",                        /* 80: continuation byte with no start */
+    };
+    for (size_t i = 0; i < lenof(bad_utf8); i++) {
+        reset(mk);
+        osc52_send(mk, "c;", bad_utf8[i], "\007");
+        IEQUAL(mk->nclip, 0);
+    }
+
+    /* Size limit, lowered so the test needs only tiny payloads */
+    IEQUAL(mk->term->osc52_max, OSC52_MAX_DECODED);    /* the default */
+    mk->term->osc52_max = 12;
+    IEQUAL(osc52_send_size(mk, 12), true);       /* exactly the limit */
+    IEQUAL(osc52_send_size(mk, 13), false);      /* one byte over */
+    IEQUAL(osc52_send_size(mk, 1000), false);    /* far over the raw buffer cap */
+
+    /* The terminal is back to normal afterwards */
+    term_datapl(mk->term, PTRLEN_LITERAL("x"));
+    IEQUAL(get_termchar(mk->term, 0, 0).chr, CSET_ASCII | 'x');
+    mk->term->osc52_max = OSC52_MAX_DECODED;     /* restore the default */
+
+    /* Newlines are converted to the platform selection newline */
+    reset(mk);
+    osc52_send(mk, "c;", "YQpiDQpj", "\007");   /* a\nb\r\nc */
+    IEQUAL(mk->nclip, 1);
+    SEQUAL(mk->clip->s, SEL_NL_TEST_STR("a", "b", "c"));
+
+    /* Other OSC sequences are unaffected */
+    reset(mk);
+    term_datapl(mk->term, PTRLEN_LITERAL("\033]2;title\007"));
+    term_update(mk->term);
+    SEQUAL(mk->title->s, "title");
+
+    /* Disabling again turns writes off */
+    osc52_set(mk, OSC52_DENY);
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nclip, 0);
+}
+
+static bool has_str(const char *hay, const char *needle)
+{
+    return strstr(hay, needle) != NULL;
+}
+
+static void test_osc52_ask(Mock *mk)
+{
+    mk->ucsdata->line_codepage = CP_UTF8;
+
+    /* Ask, user answers Yes: the dialog is shown once, then it is written */
+    osc52_set(mk, OSC52_ASK);
+    mk->confirm_answer = true;
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");          /* hello */
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(mk->nclip, 1);
+    SEQUAL(mk->clip->s, "hello");
+    IEQUAL(has_str(mk->confirm_msg->s, "5 bytes, 1 line"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "hello"), true);
+
+    /* Yes is not remembered: the next request prompts again */
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 2);
+    IEQUAL(mk->nclip, 2);
+
+    /* Ask, user answers No: nothing is written, and the terminal stops
+     * asking until the user types, pastes or changes the settings */
+    osc52_set(mk, OSC52_ASK);
+    mk->confirm_answer = false;
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    /* The dialog was shown once, and the No means nothing is written */
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(mk->nclip, 0);
+
+    /* The same request again, with the mock now answering Yes */
+    mk->confirm_answer = true;
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    /* No dialog (the refusal is remembered), so still nothing written */
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(mk->nclip, 0);
+
+    /* Typing something, then the request, with the mock answering No */
+    term_keyinput(mk->term, -1, "a", 1);
+    mk->confirm_answer = false;
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    /* Typing cleared the refusal: the dialog is shown again, and the
+     * new No is remembered */
+    IEQUAL(mk->nconfirm, 2);
+    IEQUAL(mk->nclip, 0);
+
+    /* Pasting something, then the request, with the mock answering No */
+    term_do_paste(mk->term, L"v", 1);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    /* Pasting cleared the refusal too: the dialog is shown a third time */
+    IEQUAL(mk->nconfirm, 3);
+    IEQUAL(mk->nclip, 0);
+
+    /* Changing the settings, then the request, with the mock answering Yes */
+    mk->confirm_answer = true;
+    osc52_set(mk, OSC52_ASK);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    /* The settings change cleared the refusal: the dialog is shown, the
+     * Yes is accepted, and the text is written */
+    IEQUAL(mk->nconfirm, 4);
+    IEQUAL(mk->nclip, 1);
+
+    /* Invalid requests never reach the prompt */
+    reset(mk);
+    osc52_send(mk, "c;", "?", "\007");
+    osc52_send(mk, "c;", "/w==", "\007");
+    osc52_send(mk, "c;", "aGVsbG8", "\007");
+    IEQUAL(mk->nconfirm, 0);
+    IEQUAL(mk->nclip, 0);
+
+    /* Preview: line count, newlines flattened, control and bidi characters
+     * shown as '.'. Bidi (bidirectional text) controls such as U+202E
+     * change the direction text is drawn in, so the preview could read
+     * differently from what is written to the clipboard.
+     * The text is "a\nb\x01<U+202E>z\nc" */
+    reset(mk);
+    osc52_send(mk, "c;", "YQpiAeKArnoKYw==", "\007");
+    IEQUAL(mk->nconfirm, 1);
+    IEQUAL(has_str(mk->confirm_msg->s, "3 lines"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "a b..z c"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "\xE2\x80\xAE"), false);
+    IEQUAL(has_str(mk->confirm_msg->s, "\x01"), false);
+
+    /* Long text: the preview is cut short, but the full text is written */
+    IEQUAL(osc52_send_size(mk, 1000), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "1000 bytes"), true);
+    IEQUAL(has_str(mk->confirm_msg->s, "..."), true);
+    IEQUAL(strlen(mk->confirm_msg->s) < 400, true);
+
+    /* Allow mode writes without prompting */
+    osc52_set(mk, OSC52_ALLOW);
+    reset(mk);
+    osc52_send(mk, "c;", "aGVsbG8=", "\007");
+    IEQUAL(mk->nconfirm, 0);
+    IEQUAL(mk->nclip, 1);
+
+    osc52_set(mk, OSC52_DENY);
+}
